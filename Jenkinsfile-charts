pipeline {
  agent { label 'default' }
  options {
    timeout(time: 15, unit: 'MINUTES')
  }
  environment {
    ARTIFACTORY_CREDS = credentials("ARTIFACTORY_USERNAME_TOKEN")
  }
  stages {
    stage('Push Helm Charts') {
      steps {
        script {
          // Branch-only, no PR logic: stable publishes to release-local (a
          // separate promotion job pushes from there to
          // layer7.packages.broadcom.com); develop/gateway, develop/portal
          // publish to dev-local; every other branch
          // publishes nothing.
          def DEV_LOCAL_BRANCHES = ['develop/gateway', 'develop/portal']
          if (env.BRANCH_NAME == 'stable') {
            sh 'python3 package_push_helm_charts.py --release'
          } else if (DEV_LOCAL_BRANCHES.contains(env.BRANCH_NAME)) {
            sh 'python3 package_push_helm_charts.py'
          } else {
            echo "branch '${env.BRANCH_NAME}' is not stable or a dev-local branch - skipping chart publish"
          }
        }
      }
    }
  }
}
